{
	"name": "glyph-motion-studio-webmcp",
	"version": "0.1.0",
	"private": true,
	"description": "Glyph Motion Studio for WebMCP — a visual GSAP timeline editor that lets your browser agent act as a motion-design collaborator through typed, validated site tools.",
	"type": "module",
	"scripts": {
