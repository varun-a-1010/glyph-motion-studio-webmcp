		"@types/node": "^20",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"gsap": "^3.14.2"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.0.5"
